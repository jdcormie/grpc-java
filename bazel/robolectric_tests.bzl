"""Runs grpc-java's Robolectric tests in Bazel the way Gradle runs them."""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_android//rules:rules.bzl", "android_local_test")

# Gradle gives Robolectric no manifest, so tests run on Robolectric's oldest
# supported SDK unless they ask for others with @Config(sdk = ...), and the app
# declares no components. android_local_test always gives Robolectric a
# manifest, merged with those of all deps. So pin the SDK, which the merger
# would otherwise copy from a library (31 today, from the androidx AARs). And
# replace <application>, which drops the components libraries declare, like
# androidx.profileinstaller's receiver.
_MANIFEST = """\
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="{package}">
    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="23" />
    <application tools:node="replace" />
</manifest>
"""

# Bazel's test runner initializes test_class with Class.forName() before
# Robolectric creates its sandbox. Static initializers that call Android APIs
# would then hit android.jar's stubs and fail with "Stub!". Like Gradle, JUnit's
# Suite hands test classes to their runners without initializing them, so
# Robolectric initializes them inside its sandbox instead.
_SUITE = """\
package {package};

/** Generated by robolectric_tests() in //bazel:robolectric_tests.bzl. */
@org.junit.runner.RunWith(org.junit.runners.Suite.class)
@org.junit.runners.Suite.SuiteClasses({{
{test_classes}
}})
public final class {suite_class} {{}}
"""

_SUITE_CLASS = "AllRobolectricTests"

def robolectric_tests(
        name,
        srcs,
        deps,
        custom_package,
        java_root = "src/test/java/",
        jvm_flags = ["-Xmx1g"],
        **kwargs):
    """Runs a module's Robolectric tests, like Gradle's testDebugUnitTest.

    Creates one android_local_test that compiles srcs together and runs every
    test class in them, in one JVM per shard. Adding a *Test.java file adds its
    tests. Robolectric runs offline against the Android jars in
    @robolectric_sdks and, as under Gradle, on SDK 23 unless a test asks for
    other SDKs with @Config(sdk = ...).

    This is one test, not one per class as in google3, because rules_android
    builds a deploy jar for every android_local_test. Each is about 230 MB,
    nearly all of it Robolectric's runtime (fonts, ICU data, native libraries).
    Use shard_count to run tests in parallel, and --test_filter to run a single
    class or method.

    Args:
      name: Name of the test.
      srcs: Sources of the tests and their helpers, e.g.
        glob(["src/test/java/**/*.java"]). Each *Test.java file must contain
        a test class.
      deps: Dependencies of the tests.
      custom_package: Java package of the generated manifest, R class and test
        suite.
      java_root: Prefix of each src that isn't part of its Java package.
      jvm_flags: Flags for the test JVMs. The default heap limit replaces
        rules_android's 8 GB, so that shards running in parallel fit in memory.
      **kwargs: Extra attributes for the android_local_test, e.g. shard_count.
    """
    test_classes = []
    for src in srcs:
        if not src.startswith(java_root) or not src.endswith(".java"):
            fail("Expected a .java file under %s, got %s" % (java_root, src))
        if src.endswith("Test.java"):
            test_classes.append(src[len(java_root):-len(".java")].replace("/", "."))
    if not test_classes:
        fail("srcs has no *Test.java files")

    write_file(
        name = "_%s_manifest" % name,
        out = "_%s/AndroidManifest.xml" % name,
        content = [_MANIFEST.format(package = custom_package)],
    )
    write_file(
        name = "_%s_suite" % name,
        out = "_%s/%s.java" % (name, _SUITE_CLASS),
        content = [_SUITE.format(
            package = custom_package,
            test_classes = ",\n".join(["    %s.class" % c for c in sorted(test_classes)]),
            suite_class = _SUITE_CLASS,
        )],
    )
    android_local_test(
        name = name,
        srcs = srcs + [":_%s_suite" % name],
        test_class = "%s.%s" % (custom_package, _SUITE_CLASS),
        custom_package = custom_package,
        manifest = ":_%s_manifest" % name,
        jvm_flags = jvm_flags,
        # Replaces rules_android's default, which would fetch every SDK and
        # needs a Python toolchain.
        robolectric_properties_file = Label("@robolectric_sdks//:robolectric-deps.properties"),
        data = [Label("@robolectric_sdks//:android_all")] + kwargs.pop("data", []),
        deps = deps,
        **kwargs
    )
